# Secrets — copy .env.example to web/.env.local
.env
.env.*
!.env.example

# Raw downloads are cached locally only; commit data/processed
data/raw/*
!data/raw/.gitkeep
# Copied from data/processed by `npm run sync-data` (A7)
web/public/data/

# Python
.venv/
__pycache__/
*.pyc
.pytest_cache/

# Node / Next.js (also covered by web/.gitignore)
node_modules/
.next/

# Editor and OS
.vscode/
.DS_Store
Thumbs.db
