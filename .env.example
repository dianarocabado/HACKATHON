# Copy to web/.env.local — never commit the real file
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
# Optional server speech-to-text (fallback when browser speech fails)
STT_API_KEY=
# Store: "memory" for development/offline, "supabase" for the live demo
STORE=memory
# Read at build time, rebuild after changing.
# false = real API and pipeline data; true = contracts/samples only
NEXT_PUBLIC_USE_MOCK=false
# Address the QR posters (/qr) point to, e.g. https://<project>.vercel.app or http://<laptop-ip>:3000.
# Empty = the address the /qr page was opened with.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
